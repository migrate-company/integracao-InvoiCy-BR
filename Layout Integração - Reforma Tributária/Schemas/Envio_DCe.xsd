<xs:schema xmlns="" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns:xs="http://www.w3.org/2001/XMLSchema" id="NewDataSet">
	<xs:element name="Envio">
		<xs:annotation>
			<xs:documentation>Elemento raiz da estrutura de envio da DC-e</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ModeloDocumento">
					<xs:annotation>
						<xs:documentation>Modelo de documento a ser enviado</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="10"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Versao">
					<xs:annotation>
						<xs:documentation>Versão do leiaute</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:decimal">
							<xs:totalDigits value="7"/>
							<xs:fractionDigits value="2"/>
							<xs:minInclusive value="0"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ide">
					<xs:annotation>
						<xs:documentation>Informações de identificação da DC-e</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="cUF">
								<xs:annotation>
									<xs:documentation>Código da UF do emitente da DC-e</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:nonNegativeInteger">
										<xs:pattern value="[0-9]{2}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="cDC">
								<xs:annotation>
									<xs:documentation>Código numérico que compõe a Chave de Acesso</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:nonNegativeInteger">
										<xs:totalDigits value="6"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="mod">
								<xs:annotation>
									<xs:documentation>Código do modelo do documento fiscal</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:nonNegativeInteger">
										<xs:pattern value="[0-9]{2}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="serie">
								<xs:annotation>
									<xs:documentation>Série da DC-e</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="1"/>
										<xs:maxLength value="3"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="nDC">
								<xs:annotation>
									<xs:documentation>Número da DC-e</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:nonNegativeInteger">
										<xs:totalDigits value="9"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="dhEmi" type="xs:dateTime">
								<xs:annotation>
									<xs:documentation>Data e hora de emissão da DC-e</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="fusoHorario">
								<xs:annotation>
									<xs:documentation>Fuso horário da emissão</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="([-]|[+])[0-9]{2}:(0|3)0"/>
										<xs:maxLength value="6"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="tpEmis">
								<xs:annotation>
									<xs:documentation>Tipo de emissão da DC-e</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:nonNegativeInteger">
										<xs:totalDigits value="1"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="tpEmit">
								<xs:annotation>
									<xs:documentation>Tipo do emitente da DC-e</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:nonNegativeInteger">
										<xs:totalDigits value="1"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="nSiteAutoriz">
								<xs:annotation>
									<xs:documentation>Número do site do autorizador de recepção da DC-e</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:nonNegativeInteger">
										<xs:totalDigits value="1"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="tpAmb">
								<xs:annotation>
									<xs:documentation>Identificação do ambiente</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:integer">
										<xs:enumeration value="1"/>
										<xs:enumeration value="2"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="verProc">
								<xs:annotation>
									<xs:documentation>Versão do processo de emissão</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="1"/>
										<xs:maxLength value="20"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="emit">
					<xs:annotation>
						<xs:documentation>Grupo de identificação do emitente da DC-e</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:choice>
								<xs:element name="CNPJ">
									<xs:annotation>
										<xs:documentation>CNPJ do emitente</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:pattern value="[A-Z0-9]{12}[0-9]{2}"/>
											<xs:maxLength value="14"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="CPF">
									<xs:annotation>
										<xs:documentation>CPF do emitente</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:pattern value="[0-9]{11}"/>
											<xs:maxLength value="11"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="idOutros">
									<xs:annotation>
										<xs:documentation>Identificação do emitente estrangeiro / outros</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:minLength value="2"/>
											<xs:maxLength value="60"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
							</xs:choice>
							<xs:element name="xNome">
								<xs:annotation>
									<xs:documentation>Razão social ou nome do emitente</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="2"/>
										<xs:maxLength value="60"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="enderEmit">
								<xs:annotation>
									<xs:documentation>Grupo do endereço do emitente</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="xLgr">
											<xs:annotation>
												<xs:documentation>Logradouro</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="2"/>
													<xs:maxLength value="60"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="nro">
											<xs:annotation>
												<xs:documentation>Número</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="60"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element minOccurs="0" name="xCpl">
											<xs:annotation>
												<xs:documentation>Complemento</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="60"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="xBairro">
											<xs:annotation>
												<xs:documentation>Bairro</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="2"/>
													<xs:maxLength value="60"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="cMun">
											<xs:annotation>
												<xs:documentation>Código do município</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:nonNegativeInteger">
													<xs:pattern value="[0-9]{7}"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="xMun">
											<xs:annotation>
												<xs:documentation>Nome do município</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="2"/>
													<xs:maxLength value="60"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="UF">
											<xs:annotation>
												<xs:documentation>Sigla da UF</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:pattern value="[A-Z]{2}"/>
													<xs:maxLength value="2"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element minOccurs="0" name="CEP">
											<xs:annotation>
												<xs:documentation>Código do CEP</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:pattern value="[0-9]{8}"/>
													<xs:maxLength value="8"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element minOccurs="0" name="cPais">
											<xs:annotation>
												<xs:documentation>Código do país</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:nonNegativeInteger">
													<xs:pattern value="[0-9]{4}"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element minOccurs="0" name="xPais">
											<xs:annotation>
												<xs:documentation>Nome do país</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="60"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element minOccurs="0" name="fone">
											<xs:annotation>
												<xs:documentation>Telefone</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:nonNegativeInteger">
													<xs:totalDigits value="14"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:choice minOccurs="0">
					<xs:element name="Fisco">
						<xs:annotation>
							<xs:documentation>Grupo de identificação do Fisco emitente</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:element name="CNPJ">
									<xs:annotation>
										<xs:documentation>CNPJ do órgão do Fisco</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:pattern value="[A-Z0-9]{12}[0-9]{2}"/>
											<xs:maxLength value="14"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="xOrgao">
									<xs:annotation>
										<xs:documentation>Nome do órgão do Fisco</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:minLength value="1"/>
											<xs:maxLength value="60"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="UF">
									<xs:annotation>
										<xs:documentation>Sigla da UF do Fisco</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:pattern value="[A-Z]{2}"/>
											<xs:maxLength value="2"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="Marketplace">
						<xs:annotation>
							<xs:documentation>Grupo de identificação do Marketplace</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:element name="CNPJ">
									<xs:annotation>
										<xs:documentation>CNPJ do Marketplace</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:pattern value="[A-Z0-9]{12}[0-9]{2}"/>
											<xs:maxLength value="14"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="xNome">
									<xs:annotation>
										<xs:documentation>Razão social do Marketplace</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:minLength value="1"/>
											<xs:maxLength value="60"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="Site">
									<xs:annotation>
										<xs:documentation>Endereço do site do Marketplace</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:minLength value="1"/>
											<xs:maxLength value="120"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="Transportadora">
						<xs:annotation>
							<xs:documentation>Grupo de identificação da Transportadora emitente</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:element name="CNPJ">
									<xs:annotation>
										<xs:documentation>CNPJ da Transportadora</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:pattern value="[A-Z0-9]{12}[0-9]{2}"/>
											<xs:maxLength value="14"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="xNome">
									<xs:annotation>
										<xs:documentation>Razão social da Transportadora</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:minLength value="1"/>
											<xs:maxLength value="60"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="ECT">
						<xs:annotation>
							<xs:documentation>Grupo de identificação da ECT (Correios)</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:element name="CNPJ">
									<xs:annotation>
										<xs:documentation>CNPJ da ECT</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:pattern value="[A-Z0-9]{12}[0-9]{2}"/>
											<xs:maxLength value="14"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="xNome">
									<xs:annotation>
										<xs:documentation>Razão social da ECT</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:minLength value="1"/>
											<xs:maxLength value="60"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:choice>
				<xs:element name="dest">
					<xs:annotation>
						<xs:documentation>Grupo de identificação do destinatário da DC-e</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:choice>
								<xs:element name="CNPJ">
									<xs:annotation>
										<xs:documentation>CNPJ do destinatário</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:pattern value="[A-Z0-9]{12}[0-9]{2}"/>
											<xs:maxLength value="14"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="CPF">
									<xs:annotation>
										<xs:documentation>CPF do destinatário</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:pattern value="[0-9]{11}"/>
											<xs:maxLength value="11"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="idOutros">
									<xs:annotation>
										<xs:documentation>Identificação do destinatário estrangeiro / outros</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:minLength value="2"/>
											<xs:maxLength value="60"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
							</xs:choice>
							<xs:element name="xNome">
								<xs:annotation>
									<xs:documentation>Razão social ou nome do destinatário</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="2"/>
										<xs:maxLength value="60"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="enderDest">
								<xs:annotation>
									<xs:documentation>Grupo do endereço do destinatário</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="xLgr">
											<xs:annotation>
												<xs:documentation>Logradouro</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="2"/>
													<xs:maxLength value="60"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="nro">
											<xs:annotation>
												<xs:documentation>Número</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="60"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element minOccurs="0" name="xCpl">
											<xs:annotation>
												<xs:documentation>Complemento</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="60"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="xBairro">
											<xs:annotation>
												<xs:documentation>Bairro</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="2"/>
													<xs:maxLength value="60"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="cMun">
											<xs:annotation>
												<xs:documentation>Código do município</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:nonNegativeInteger">
													<xs:pattern value="[0-9]{7}"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="xMun">
											<xs:annotation>
												<xs:documentation>Nome do município</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="2"/>
													<xs:maxLength value="60"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="UF">
											<xs:annotation>
												<xs:documentation>Sigla da UF</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:pattern value="[A-Z]{2}"/>
													<xs:maxLength value="2"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element minOccurs="0" name="CEP">
											<xs:annotation>
												<xs:documentation>Código do CEP</xs:documentation>
